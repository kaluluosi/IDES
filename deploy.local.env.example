# 火山站部署配置（本地文件，**不入库**）
#
# 用法：cp deploy.local.env.example deploy.local.env 然后填好下面的值。
# deploy.local.env 已被 .gitignore 忽略，不会被推到公开仓库。
#
# 本文件只放「环境相关」信息；域名、备案号等公开信息用脚本内置默认值即可。

# 部署目标服务器（SSH 可达，需已配置免密登录）
HOST=root@<服务器IP>

# 服务器上的站点根目录（mkdir -p 由首次部署自行创建）
REMOTE_ROOT=/opt/<站点目录>

# 可选：覆盖脚本内置的公开默认值
# SITE_URL=https://example.com/
# ICP_BEIAN=京ICP备0000000号
# VERIFY_URL=https://example.com/
